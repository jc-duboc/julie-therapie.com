{
  "model": "claude-sonnet-4-6",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0"
  },
  "skipAutoPermissionPrompt": true,
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git config --global user.name *)",
      "Bash(git config --global user.email *)",
      "Bash(git config --get *)",
      "Bash(git config --list)",
      "Bash(git config --list *)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(git --version)",
      "Bash(quarto preview)",
      "Bash(quarto preview *)",
      "Bash(quarto render)",
      "Bash(quarto render *)",
      "Bash(quarto check)",
      "Bash(quarto check *)",
      "Bash(quarto add *)",
      "Bash(quarto install *)",
      "Bash(quarto list *)",
      "Bash(quarto --version)",
      "Bash(node scripts/fetch-youtube-playlists.mjs)",
      "Bash(node scripts/fetch-youtube-playlists.mjs *)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(gh auth status)",
      "Bash(gh auth login)",
      "Bash(gh auth login *)",
      "Bash(gh run watch)",
      "Bash(gh run watch *)",
      "Bash(gh run list)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh api user)",
      "Bash(gh api user *)",
      "Bash(gh --version)",
      "Bash(winget --version)",
      "Bash(winget search *)",
      "Bash(winget list *)",
      "Bash(winget install --id Git.Git*)",
      "Bash(winget install --id OpenJS.NodeJS.LTS*)",
      "Bash(winget install --id Quarto.Quarto*)",
      "Bash(winget install --id GitHub.cli*)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(mkdir *)",
      "Bash(where *)",
      "Bash(which *)",
      "Skill(quarto-authoring)",
      "Skill(brand-yml)",
      "Skill(frontend-design)",
      "Skill(webapp-testing)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git checkout --*)",
      "Bash(git restore --*)",
      "Bash(git branch -D*)",
      "Bash(git rebase*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)"
    ],
    "defaultMode": "acceptEdits"
  }
}